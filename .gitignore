# Build artifacts for every Lambda (glob, so new Lambdas are covered automatically).
# NOTE: package-lock.json is intentionally NOT globbed — chat-stream and blueprint
# commit their lockfiles so CI can `npm ci`. Only kb-builder (npm install) ignores it.
lambda/*/node_modules/
lambda/*/function.zip
lambda/kb-builder/package-lock.json

# Superpowers brainstorming sessions
.superpowers/

# Git worktrees
.worktrees/

# Reference materials (not deployed)
Anthropic Academy/

# Uncompressed 3D model — only public/alti.glb is shipped
/alti.glb

# Workshop/reference PDFs at repo root — keep public/**/*.pdf trackable
/*.pdf

# Coverage reports
coverage/

# Test results (JUnit XML from vitest + node --test)
test-results/
lambda-test-results.xml

# Code quality report (generated by CI)
code-quality-report.json

# Lambda deployment package size report (generated by scripts/track-lambda-size.mjs --output)
lambda-size-report.json

# Blog heading rewrite patch report (default --out= of scripts/rewrite-blog-headings.mjs,
# written on every dry run so the audit trail survives a half-applied migration)
blog-heading-rewrite-patch.json

# Vector Podcast KB ingestion — local staging + source transcripts (not committed)
podcast-kb-staging/
podcast-transcripts/
.transcribe-audio/

# TypeScript / Vite build artifacts (emitted by `tsc` in the build step)
*.tsbuildinfo
vite.config.d.ts
vite.config.js

# Local Claude Code tooling scratch (screenshots, workflow scripts, local settings)
.claude/

# Local design-tool state and terminal session captures
.impeccable/
/typescript

# Raw source images — input for the not-yet-run editorial redesign (kept on disk, not versioned)
scripts/editorial-raw/

# jscpd duplicate code report
jscpd-report/

# Turborepo task cache
.turbo/

# Generated API documentation (run: npm run docs:gen)
docs/api/
